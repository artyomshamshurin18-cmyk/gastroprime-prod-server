generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  password         String
  firstName        String?
  lastName         String?
  jobTitle         String?
  phone            String?
  allergies        String?
  avatarUrl        String?
  role             String   @default("CLIENT")
  status           String   @default("ACTIVE")
  companyId        String?
  mealModeOverride String?
  setTypeOverride  String?
  isHalal          Boolean  @default(false)
  isVip            Boolean  @default(false)
  avoidGarlic      Boolean  @default(false)
  avoidMayonnaise  Boolean  @default(false)
  routeName        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company             Company?             @relation("CompanyMembers", fields: [companyId], references: [id])
  ownedCompany        Company?             @relation("CompanyOwner")
  orders              Order[]
  weeklyMenus         WeeklyMenu[]
  attendanceDays      EmployeeAttendance[]
  supportMessages     SupportMessage[]
  chatParticipants    ChatParticipant[]
  chatMessages        ChatMessage[]        @relation("ChatMessageSender")
  createdChatInvites  ChatInvite[]         @relation("ChatInviteCreator")
  guestInviteSessions ChatInviteGuest[]
  driverRoutes        DriverRoute[]

  // CRM relations
  managedDeals       CrmDeal[]           @relation("CrmDealManager")
  dealLogs           CrmDealLog[]        @relation("CrmDealLogUser")
  projectMemberships CrmProjectMember[]  @relation("CrmProjectMemberUser")
  assignedTasks      CrmTask[]           @relation("CrmTaskUser")
  taskAttachments    CrmTaskAttachment[] @relation("CrmTaskAttachmentUser")
  taskComments       CrmTaskComment[]    @relation("CrmTaskCommentUser")
  logisticsPoints    LogisticsPoint[]    @relation("LogisticsPointDriver")

  projectMessages CrmProjectMessage[]
}

model Company {
  id              String  @id @default(uuid())
  accountNumber   String  @unique
  name            String
  status          String  @default("ACTIVE")
  contactPerson   String?
  creditBalance   Int     @default(0)
  contactPhone    String?
  routeName       String?
  address         String?
  logoUrl         String?
  billingAddress  String?
  billingDetails  String?
  entryConditions String?
  deliveryTime    String?
  peopleCount     String?
  notes           String?
  mealPlan        String?
  workEmail       String?
  phone           String?
  website         String?
  priceSegment    String  @default("STANDARD")
  defaultSetType  String  @default("FULL")
  balance         Int     @default(0)
  limit           Int     @default(50000)
  dailyLimit      Int     @default(0)
  userId          String? @unique
  user            User?   @relation("CompanyOwner", fields: [userId], references: [id])

  users                User[]                 @relation("CompanyMembers")
  orders               Order[]
  deliveryClosings     DeliveryClosing[]
  invoices             Invoice[]
  supportMessages      SupportMessage[]
  chatConversations    ChatConversation[]
  chatInvites          ChatInvite[]
  categoryPrices       CompanyCategoryPrice[]
  files                CompanyFile[]
  companyDocuments     CompanyDocument[]
  driverRouteCompanies DriverRouteCompany[]
  logisticsPoints      LogisticsPoint[]       @relation("LogisticsPointCompany")

  // CRM relations
  crmDeals      CrmDeal[]      @relation("CrmDealCompany")
  crmPayments   CrmPayment[]   @relation("CrmPaymentCompany")
  crmProjects   CrmProject[]   @relation("CrmProjectCompany")
  crmRouteStops CrmRouteStop[] @relation("CrmRouteStopCompany")
  crmTasks      CrmTask[]      @relation("CrmTaskCompany")
}

model CompanyFile {
  id        String   @id @default(uuid())
  companyId String
  fileName  String
  fileUrl   String
  mimeType  String
  sizeBytes Int
  kind      String   @default("DOCUMENT")
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model CompanyDocument {
  id        String   @id @default(uuid())
  companyId String
  name      String
  filename  String
  size      Int
  mimeType  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model BillingSettings {
  key           String   @id @default("main")
  sellerName    String?
  sellerAddress String?
  sellerDetails String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DeliveryClosing {
  id               String   @id @default(uuid())
  companyId        String
  date             DateTime
  status           String   @default("DELIVERED")
  deviationAmount  Int      @default(0)
  deviationComment String?
  managerComment   String?
  createdById      String?
  updatedById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date])
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  dishes        Dish[]
  companyPrices CompanyCategoryPrice[]
}

model Dish {
  id                 String   @id @default(uuid())
  name               String
  description        String?
  photoUrl           String?
  price              Int
  calories           Int?
  weight             Int?
  measureUnit        String   @default("GRAM")
  containsPork       Boolean  @default(false)
  containsGarlic     Boolean  @default(false)
  containsMayonnaise Boolean  @default(false)
  breakfastPart      String?
  categoryId         String
  category           Category @relation(fields: [categoryId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  orderItems               OrderItem[]
  dailyMenuItems           DailyMenuItem[] @relation("dish_items")
  garnishMenuItems         DailyMenuItem[] @relation("garnish_items")
  selectedDishes           SelectedDish[]
  selectedDishGarnishItems SelectedDish[]  @relation("selected_dish_garnish")
}

// Меню на конкретный день
model DailyMenu {
  id        String   @id @default(uuid())
  date      DateTime @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items DailyMenuItem[]
}

// Блюда в меню на день (с лимитом количества)
model DailyMenuItem {
  id            String  @id @default(uuid())
  dailyMenuId   String
  dishId        String
  maxQuantity   Int     @default(100)
  sortOrder     Int     @default(0)
  garnishDishId String?
  garnishDish   Dish?   @relation("garnish_items", fields: [garnishDishId], references: [id])

  dailyMenu DailyMenu @relation(fields: [dailyMenuId], references: [id], onDelete: Cascade)
  dish      Dish      @relation("dish_items", fields: [dishId], references: [id])

  @@unique([dailyMenuId, dishId])
}

// Выбор клиента на неделю/период
model WeeklyMenu {
  id            String    @id @default(uuid())
  userId        String
  startDate     DateTime
  endDate       DateTime
  status        String    @default("DRAFT")
  chargedAt     DateTime?
  chargedAmount Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user       User           @relation(fields: [userId], references: [id])
  selections DaySelection[]

  @@index([userId])
}

// Выбор на конкретный день
model DaySelection {
  id           String   @id @default(uuid())
  weeklyMenuId String
  date         DateTime
  utensils     Int      @default(1)
  needBread    Boolean  @default(true)
  notes        String?

  weeklyMenu WeeklyMenu     @relation(fields: [weeklyMenuId], references: [id], onDelete: Cascade)
  items      SelectedDish[]

  @@unique([weeklyMenuId, date])
}

// Выбранное блюдо на день
model SelectedDish {
  id             String  @id @default(uuid())
  daySelectionId String
  dishId         String
  quantity       Int     @default(1)
  garnishDishId  String?

  daySelection DaySelection @relation(fields: [daySelectionId], references: [id], onDelete: Cascade)
  dish         Dish         @relation(fields: [dishId], references: [id])
  garnishDish  Dish?        @relation("selected_dish_garnish", fields: [garnishDishId], references: [id])
}

model EmployeeAttendance {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime
  status    String   @default("OFFICE")
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model Order {
  id           String      @id @default(uuid())
  orderNumber  String      @unique
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id])
  status       String      @default("PENDING")
  totalAmount  Int
  deliveryDate DateTime
  deliveryTime String?
  comment      String?
  items        OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dishId    String
  dish      Dish   @relation(fields: [dishId], references: [id])
  quantity  Int
  unitPrice Int
}

model Invoice {
  id                    String    @id @default(uuid())
  number                String    @unique
  companyId             String
  type                  String    @default("PERIOD")
  status                String    @default("ISSUED")
  periodStart           DateTime?
  periodEnd             DateTime?
  issueDate             DateTime  @default(now())
  dueDate               DateTime?
  currency              String    @default("KZT")
  subtotal              Int       @default(0)
  deviationTotal        Int       @default(0)
  total                 Int       @default(0)
  comment               String?
  buyerSnapshotName     String
  buyerSnapshotAddress  String?
  buyerSnapshotDetails  String?
  sellerSnapshotName    String
  sellerSnapshotAddress String?
  sellerSnapshotDetails String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines   InvoiceLine[]
}

model InvoiceLine {
  id              String    @id @default(uuid())
  invoiceId       String
  date            DateTime?
  description     String
  quantity        Int?
  unitPrice       Int?
  amount          Int       @default(0)
  deviationAmount Int       @default(0)
  total           Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model SupportMessage {
  id        String   @id @default(uuid())
  companyId String
  userId    String
  text      String
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([userId, createdAt])
}

model ChatConversation {
  id        String   @id @default(uuid())
  companyId String
  title     String?
  type      String   @default("COMPANY_SUPPORT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  participants ChatParticipant[]
  messages     ChatMessage[]
  invites      ChatInvite[]

  @@unique([companyId, type])
  @@index([companyId])
}

model ChatParticipant {
  id                    String    @id @default(uuid())
  conversationId        String
  userId                String
  canManageParticipants Boolean   @default(false)
  joinedAt              DateTime  @default(now())
  lastReadAt            DateTime?

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, lastReadAt])
}

model ChatMessage {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  text           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User             @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  attachments  ChatAttachment[]

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

model ChatAttachment {
  id        String   @id @default(uuid())
  messageId String
  fileName  String
  fileUrl   String
  mimeType  String
  sizeBytes Int
  kind      String   @default("FILE")
  createdAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model ChatInvite {
  id              String    @id @default(uuid())
  conversationId  String
  companyId       String
  createdByUserId String
  token           String    @unique
  label           String?
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  conversation ChatConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy    User              @relation("ChatInviteCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  guests       ChatInviteGuest[]

  @@index([conversationId, revokedAt])
  @@index([companyId, revokedAt])
}

model ChatInviteGuest {
  id          String    @id @default(uuid())
  inviteId    String
  userId      String    @unique
  accessToken String    @unique
  guestName   String
  guestEmail  String?
  guestPhone  String?
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime?

  invite ChatInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([inviteId])
}

model CompanyCategoryPrice {
  id         String   @id @default(uuid())
  companyId  String
  categoryId String
  price      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([companyId, categoryId])
  @@index([companyId])
  @@index([categoryId])
}

model DriverRoute {
  id        String   @id @default(uuid())
  driverId  String
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driver    User                 @relation(fields: [driverId], references: [id])
  companies DriverRouteCompany[]

  @@unique([driverId, date])
  @@index([driverId, date])
  @@index([date])
}

model DriverRouteCompany {
  id              String    @id @default(uuid())
  driverRouteId   String
  companyId       String
  deliveryStatus  String    @default("PENDING")
  statusChangedAt DateTime?
  arrivedAt       DateTime?
  unloadedAt      DateTime?
  departedAt      DateTime?
  driverNote      String?
  sortOrder       Int       @default(0)
  garnishDishId   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  driverRoute DriverRoute @relation(fields: [driverRouteId], references: [id], onDelete: Cascade)
  company     Company     @relation(fields: [companyId], references: [id])

  @@unique([driverRouteId, companyId])
  @@index([driverRouteId, sortOrder])
}

model LogisticsPoint {
  id              String   @id @default(uuid())
  companyId       String?
  driverId        String   @map("driverId")
  routeName       String?
  date            DateTime
  type            String   @default("point")
  address         String?
  contactPerson   String?
  contactPhone    String?
  timeWindowStart String?
  timeWindowEnd   String?
  note            String?
  fileUrl         String?
  sortOrder       Int      @default(0)
  garnishDishId   String?
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company? @relation("LogisticsPointCompany", fields: [companyId], references: [id])
  driver  User?    @relation("LogisticsPointDriver", fields: [driverId], references: [id])

  @@index([driverId, date])
}

// ===== CRM Models =====

model CrmDeal {
  id              String    @id @default(uuid())
  companyId       String
  managerId       String
  stage           String    @default("LEAD")
  probability     Int       @default(10)
  nextContactDate DateTime?
  source          String    @default("COLD")
  notes           String?
  estimatedAmount Int       @default(0)
  minPrice        Int?
  maxPrice        Int?
  workDays        Int?
  closedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company Company @relation("CrmDealCompany", fields: [companyId], references: [id])
  manager User?   @relation("CrmDealManager", fields: [managerId], references: [id])

  logs CrmDealLog[]
}

model CrmDealLog {
  id        String   @id @default(uuid())
  dealId    String
  userId    String
  action    String
  oldValue  String?
  newValue  String?
  comment   String?
  createdAt DateTime @default(now())

  deal CrmDeal @relation(fields: [dealId], references: [id])
  user User?   @relation("CrmDealLogUser", fields: [userId], references: [id])
}

model CrmPayment {
  id          String   @id @default(uuid())
  companyId   String
  amount      Int
  type        String   @default("PAYMENT")
  method      String   @default("BANK_TRANSFER")
  description String?
  date        DateTime @default(now())
  createdById String?
  createdAt   DateTime @default(now())

  company Company @relation("CrmPaymentCompany", fields: [companyId], references: [id])
}

model CrmProject {
  id          String    @id @default(uuid())
  name        String
  description String?
  companyId   String?
  dealId      String?
  status      String    @default("ACTIVE")
  color       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  endDate     DateTime?

  company  Company?            @relation("CrmProjectCompany", fields: [companyId], references: [id])
  members  CrmProjectMember[]
  messages CrmProjectMessage[]
}

model CrmProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      String   @default("MEMBER")
  createdAt DateTime @default(now())

  project CrmProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User       @relation("CrmProjectMemberUser", fields: [userId], references: [id])
}

model CrmRoute {
  id          String    @id @default(uuid())
  date        DateTime
  driverName  String
  driverPhone String?
  vehicleInfo String?
  totalStops  Int       @default(0)
  totalOrders Int       @default(0)
  totalAmount Int       @default(0)
  status      String    @default("PLANNED")
  notes       String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  stops CrmRouteStop[]
}

model CrmRouteStop {
  id          String    @id @default(uuid())
  routeId     String
  companyId   String
  orderId     String?
  sortOrder   Int       @default(0)
  status      String    @default("PENDING")
  deliveredAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  route   CrmRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  company Company  @relation("CrmRouteStopCompany", fields: [companyId], references: [id])
}

model CrmTask {
  id           String    @id @default(uuid())
  title        String
  description  String?
  userId       String
  dealId       String?
  companyId    String?
  type         String    @default("FOLLOW_UP")
  priority     String    @default("NORMAL")
  status       String    @default("PENDING")
  dueDate      DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  projectId    String?
  sortOrder    Int       @default(0)
  boardStatus  String    @default("TODO")
  labels       String[]  @default([])
  parentTaskId String?

  company Company? @relation("CrmTaskCompany", fields: [companyId], references: [id])
  user    User?    @relation("CrmTaskUser", fields: [userId], references: [id])

  checklists  CrmTaskChecklist[]
  attachments CrmTaskAttachment[]
  comments    CrmTaskComment[]
}

model CrmTaskAttachment {
  id        String   @id @default(uuid())
  taskId    String?
  commentId String?
  userId    String
  fileName  String
  fileUrl   String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  task CrmTask? @relation(fields: [taskId], references: [id])
  user User?    @relation("CrmTaskAttachmentUser", fields: [userId], references: [id])
}

model CrmTaskChecklist {
  id        String   @id @default(uuid())
  taskId    String
  title     String
  completed Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task  CrmTask                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  items CrmTaskChecklistItem[]

  @@index([taskId])
}

model CrmTaskChecklistItem {
  id          String   @id @default(uuid())
  checklistId String
  text        String
  completed   Boolean  @default(false)
  assignedTo  String?
  assignedBy  String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  checklist CrmTaskChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
}

model CrmTaskComment {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  text      String
  mentions  String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task CrmTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User?   @relation("CrmTaskCommentUser", fields: [userId], references: [id])
}

model CrmProjectMessage {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project     CrmProject             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User?                  @relation(fields: [userId], references: [id])
  attachments CrmProjectAttachment[]
}

model CrmProjectAttachment {
  id        String   @id @default(uuid())
  messageId String?
  projectId String?
  fileName  String
  fileUrl   String
  fileSize  Int      @default(0)
  createdAt DateTime @default(now())

  message CrmProjectMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
}

// ===== Content models (for marketing site) =====
enum ContentType {
  PAGE_TEXT
  GALLERY
  REVIEW
  CASE
  FAQ
  SOLUTION
}

model ContentBlock {
  id          Int         @id @default(autoincrement())
  type        ContentType
  pageSlug    String?     // production, office, events, about, etc.
  key         String      // hero_title, hero_desc, benefits, etc.
  title       String?     // Заголовок блока
  subtitle    String?     // Подзаголовок
  body        String?     // HTML или JSON с контентом
  imageUrl    String?     // URL картинки
  imageAlt    String?     // Alt текст
  sortOrder   Int         @default(0)
  visible     Boolean     @default(true)
  createdAt   DateTime    @default(now()) @db.Timestamptz()
  updatedAt   DateTime    @updatedAt @db.Timestamptz()

  @@map("content_blocks")
}

model ContentPhoto {
  id          Int         @id @default(autoincrement())
  galleryKey  String      // events_gallery, cases_gallery, etc.
  filename    String      // original filename
  filepath    String      // server path
  title       String?
  sortOrder   Int         @default(0)
  visible     Boolean     @default(true)
  createdAt   DateTime    @default(now()) @db.Timestamptz()

  @@map("content_photos")
}
